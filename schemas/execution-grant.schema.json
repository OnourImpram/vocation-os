{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vocation-os.dev/schemas/execution-grant.schema.json",
  "title": "ExecutionGrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grantId",
    "approvedBy",
    "keyId",
    "allowedAdapters",
    "allowedEmployerDomains",
    "allowedOpportunityTypes",
    "allowedActionTypes",
    "allowedFields",
    "forbiddenFields",
    "minimumFitScore",
    "allowedLegitimacyTiers",
    "maxActions",
    "maxActionsPerDay",
    "validFrom",
    "expiresAt",
    "approvalTextHash",
    "signatureAlgorithm",
    "signature"
  ],
  "properties": {
    "grantId": {
      "type": "string",
      "pattern": "^GRANT-[A-Za-z0-9._:-]+$",
      "maxLength": 160
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "allowedAdapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      }
    },
    "allowedEmployerDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z0-9.-]+$",
        "maxLength": 253
      }
    },
    "allowedOpportunityTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 80
      }
    },
    "allowedActionTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "send-application-email",
          "send-outreach-email",
          "send-follow-up-email",
          "submit-ats-application"
        ]
      }
    },
    "allowedFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      }
    },
    "forbiddenFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      }
    },
    "minimumFitScore": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "allowedLegitimacyTiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["green", "yellow", "red"]
      }
    },
    "maxActions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxActionsPerDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvalTextHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signatureAlgorithm": {
      "const": "Ed25519"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 80,
      "maxLength": 100
    }
  }
}
