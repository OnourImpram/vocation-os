{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vocation-os.dev/schemas/execution-adapter-manifest.schema.json",
  "title": "ExecutionAdapterManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapterId",
    "version",
    "maturity",
    "supportedDomains",
    "supportedProfileScopes",
    "supportedActionTypes",
    "supportedFields",
    "forbiddenFields",
    "proofKinds",
    "requiresBrowser",
    "requiresLogin",
    "lastVerifiedAt",
    "recipeHash"
  ],
  "properties": {
    "adapterId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.]+)?$",
      "maxLength": 80
    },
    "maturity": {
      "type": "string",
      "enum": ["synthetic", "experimental", "stable"]
    },
    "supportedDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z0-9.-]+$",
        "maxLength": 253
      }
    },
    "supportedProfileScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["synthetic", "local-private"]
      }
    },
    "supportedActionTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "send-application-email",
          "send-outreach-email",
          "send-follow-up-email",
          "submit-ats-application"
        ]
      }
    },
    "supportedFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      }
    },
    "forbiddenFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 100
      }
    },
    "proofKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["confirmation-page", "ats-dashboard", "sent-items", "receipt-email"]
      }
    },
    "requiresBrowser": {
      "type": "boolean"
    },
    "requiresLogin": {
      "type": "boolean"
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recipeHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
